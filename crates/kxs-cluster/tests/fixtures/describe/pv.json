{
  "apiVersion": "v1", "kind": "PersistentVolume",
  "metadata": {"name": "pvc-abc", "finalizers": ["kubernetes.io/pv-protection"],
    "annotations": {"pv.kubernetes.io/provisioned-by": "ebs.csi.aws.com"}},
  "spec": {"storageClassName": "gp3", "capacity": {"storage": "10Gi"}, "accessModes": ["ReadWriteOnce"],
    "volumeMode": "Filesystem", "persistentVolumeReclaimPolicy": "Delete",
    "claimRef": {"namespace": "default", "name": "data-db-0"},
    "nodeAffinity": {"required": {"nodeSelectorTerms": [{"matchExpressions": [
      {"key": "topology.kubernetes.io/zone", "operator": "In", "values": ["us-east-1a"]}] }]}},
    "csi": {"driver": "ebs.csi.aws.com", "volumeHandle": "vol-1", "fsType": "ext4",
      "volumeAttributes": {"storage.kubernetes.io/csiProvisionerIdentity": "x"}}},
  "status": {"phase": "Bound"}
}
